#!/bin/bash

# Determine real user and home directory (compatible with sudo)
REAL_USER="${SUDO_USER:-$USER}"
if [ -z "$REAL_USER" ] || [ "$REAL_USER" = "root" ]; then
  REAL_USER=$(logname 2>/dev/null || whoami)
fi
REAL_HOME="$(eval echo ~$REAL_USER)"
if [ ! -d "$REAL_HOME" ]; then
  REAL_HOME="$HOME"
fi

PROJECT_DIR="$REAL_HOME/.pi-openai-server"
SRC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

SERVER_SCRIPT="$PROJECT_DIR/server.py"
VENV_PYTHON="$PROJECT_DIR/venv/bin/python3"
PID_FILE="/tmp/pi-openai-server.pid"
PLIST_NAME="com.pi-openai-server.plist"
SYSTEM_PLIST="/Library/LaunchDaemons/$PLIST_NAME"
SYMLINK_PATH="/usr/local/bin/pi-openai-server"

is_running() {
  if [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE")
    if ps -p "$PID" > /dev/null 2>&1; then
      return 0
    fi
  fi
  if pgrep -f "$SERVER_SCRIPT" > /dev/null 2>&1; then
    return 0
  fi
  return 1
}

case "$1" in
  start)
    if is_running; then
      echo "Server is already running."
    else
      cd "$PROJECT_DIR"
      nohup "$VENV_PYTHON" "$SERVER_SCRIPT" > "$PROJECT_DIR/logs/server.log" 2>&1 &
      echo $! > "$PID_FILE"
      echo "Server started (PID: $!)."
    fi
    ;;
  stop)
    if is_running; then
      if [ -f "$PID_FILE" ]; then
        kill $(cat "$PID_FILE") 2>/dev/null
        rm -f "$PID_FILE"
      fi
      pkill -f "$SERVER_SCRIPT" 2>/dev/null
      echo "Server stopped."
    else
      echo "Server is not running."
    fi
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  status)
    if is_running; then
      PID=$(cat "$PID_FILE" 2>/dev/null || pgrep -f "$SERVER_SCRIPT" | head -n 1)
      echo "Status: Running (PID: ${PID:-unknown})"
    else
      echo "Status: Not running"
    fi

    if [ -f "$SYSTEM_PLIST" ]; then
      echo "Service: Installed as system service ($SYSTEM_PLIST)"
    else
      echo "Service: Not installed as system service"
    fi
    echo "Project Directory: $PROJECT_DIR"
    ;;
  install)
    if [ "$EUID" -ne 0 ]; then
      echo "Installing as system service requires root permissions. Requesting sudo..."
      sudo "$0" install
      exit $?
    fi

    echo "Syncing project to hidden directory: $PROJECT_DIR"
    mkdir -p "$PROJECT_DIR"
    
    # Copy project files (excluding .git if desired, but keeping venv if present)
    rsync -av --exclude='.git' --exclude='logs/*.log' "$SRC_DIR/" "$PROJECT_DIR/"
    
    # Ensure logs directory exists with correct permissions
    mkdir -p "$PROJECT_DIR/logs"
    chown -R "$REAL_USER:staff" "$PROJECT_DIR"

    # If venv doesn't exist in target, create it and install requirements
    if [ ! -f "$VENV_PYTHON" ]; then
      echo "Creating virtual environment in $PROJECT_DIR/venv..."
      sudo -u "$REAL_USER" python3 -m venv "$PROJECT_DIR/venv"
      sudo -u "$REAL_USER" "$VENV_PYTHON" -m pip install --upgrade pip fastapi uvicorn pydantic
    fi

    mkdir -p /usr/local/bin

    TEMP_PLIST="/tmp/$PLIST_NAME"
    cat <<EOF > "$TEMP_PLIST"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pi-openai-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>$VENV_PYTHON</string>
        <string>$SERVER_SCRIPT</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>$PROJECT_DIR/logs/server.log</string>
    <key>StandardErrorPath</key>
    <string>$PROJECT_DIR/logs/server.log</string>
    <key>UserName</key>
    <string>$REAL_USER</string>
    <key>WorkingDirectory</key>
    <string>$PROJECT_DIR</string>
</dict>
</plist>
EOF

    cp "$TEMP_PLIST" "$SYSTEM_PLIST"
    chown root:wheel "$SYSTEM_PLIST"
    chmod 644 "$SYSTEM_PLIST"

    launchctl bootout system/$PLIST_NAME 2>/dev/null || launchctl unload "$SYSTEM_PLIST" 2>/dev/null || true
    launchctl enable system/$PLIST_NAME 2>/dev/null || true
    launchctl bootstrap system "$SYSTEM_PLIST" 2>/dev/null || launchctl load -w "$SYSTEM_PLIST"

    ln -sf "$PROJECT_DIR/pi-openai-server" "$SYMLINK_PATH"
    chmod +x "$PROJECT_DIR/pi-openai-server"
    chmod +x "$SYMLINK_PATH"

    echo "System service installed and loaded successfully (will start on Mac reboot)."
    echo "Project installed at: $PROJECT_DIR"
    echo "Command 'pi-openai-server' updated and linked to $SYMLINK_PATH."
    ;;
  uninstall)
    if [ "$EUID" -ne 0 ]; then
      echo "Uninstalling system service requires root permissions. Requesting sudo..."
      sudo "$0" uninstall
      exit $?
    fi

    echo "Stopping server if running..."
    "$0" stop 2>/dev/null || true

    if [ -f "$SYSTEM_PLIST" ]; then
      launchctl bootout system/$PLIST_NAME 2>/dev/null || launchctl unload "$SYSTEM_PLIST" 2>/dev/null || true
      rm -f "$SYSTEM_PLIST"
      echo "System service uninstalled and removed."
    else
      echo "System service is not installed."
    fi

    if [ -L "$SYMLINK_PATH" ] || [ -f "$SYMLINK_PATH" ]; then
      rm -f "$SYMLINK_PATH"
      echo "Global symlink removed."
    fi
    ;;
  update)
    echo "Updating pi-openai-server repository..."
    cd "$PROJECT_DIR"
    git pull origin main 2>/dev/null || echo "Not a git repo or offline, skipping git pull."

    echo "Updating Python dependencies..."
    if [ -f "$PROJECT_DIR/venv/bin/pip" ]; then
      "$PROJECT_DIR/venv/bin/pip" install --upgrade pip fastapi uvicorn pydantic
    fi

    echo "Updating global symlink..."
    if [ "$EUID" -eq 0 ]; then
      mkdir -p /usr/local/bin
      ln -sf "$PROJECT_DIR/pi-openai-server" "$SYMLINK_PATH"
      chmod +x "$PROJECT_DIR/pi-openai-server"
      chmod +x "$SYMLINK_PATH"
    else
      sudo ln -sf "$PROJECT_DIR/pi-openai-server" "$SYMLINK_PATH" 2>/dev/null || true
    fi

    echo "Restarting service/server..."
    if [ -f "$SYSTEM_PLIST" ]; then
      sudo "$0" restart
    else
      "$0" restart
    fi
    echo "Update completed successfully."
    ;;
  *)
    echo "Usage: pi-openai-server {status|start|stop|restart|install|uninstall|update}"
    exit 1
    ;;
esac
